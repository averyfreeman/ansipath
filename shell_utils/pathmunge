### example usage for $HOME/.bash_profile (et. al.)
# . $(thisfilename)
# pathmunge /path/to/add
# status = $?  # must be very next line to capture code
 
pathmunge () {
    # --- GUARD CLAUSES (Input Validation) ---
    
    # Guard 1: Ensure an argument was actually passed
    if [ -z "$1" ]; then
        echo "pathmunge error: Missing directory argument." >&2
        return 1
    fi

    # Resolve symlinks safely
    local target_path="$1"
    if [ -h "$target_path" ]; then
        target_path=$(readlink -f "$target_path")
    fi

    # Convert to a literal absolute path string
    local abs_path
    abs_path=$(cd "$(dirname "$target_path")" 2>/dev/null && pwd)/$(basename "$target_path") 2>/dev/null

    # Guard 2: Ensure the target folder physically exists on the disk
    if [ ! -d "$abs_path" ]; then
        echo "pathmunge warning: Directory '$abs_path' does not exist. Skipping." >&2
        return 2
    fi


    # --- CORE LOGIC (Pattern Matching via Case) ---
    case ":${PATH}:" in
        *:"$abs_path":*)
            # Match found! Do nothing and exit cleanly
            return 3
            ;;
        *)
            # No match found: safely append or prepend the new block
            if [ "$2" = "after" ] ; then
                PATH="$PATH:$abs_path"
            else
                PATH="$abs_path:$PATH"
            fi
            return 0
            ;;
    esac
}

report_pathmunge_status() {
    # Capture the code passed as the first argument ($1) to this function
    local status_code="$1"
    local path_name="$2"

    case "$status_code" in
        0)
            echo "Success: Added '$path_name' to \$PATH."
            ;;
        2)
            echo "Error 2: Directory '$path_name' does not exist." >&2
            ;;
        3)
            echo "Notice: '$path_name' is already present in \$PATH."
            ;;
        1|*)
            echo "Error 1: pathmunge failed for unknown reasons on '$path_name'." >&2
            ;;
    esac
}
